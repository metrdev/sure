<%# locals: (budget:) %>

<section class="space-y-4" aria-labelledby="household-budget-title">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 id="household-budget-title" class="text-xl font-medium text-primary">
        <%= t("budgets.household.title", default: "Household budget") %>
      </h2>
      <p class="text-sm text-secondary">
        <%= t("budgets.household.description", default: "Only shared categories appear here. Every member's matching transactions count against one limit.") %>
      </p>
    </div>

    <% if budget.budget_categories.any? && !Current.user.guest? %>
      <%= render DS::Link.new(
            text: t("budgets.show.categories.edit"),
            variant: "secondary",
            icon: "settings-2",
            href: budget_budget_categories_path(budget, scope: "household")
          ) %>
    <% end %>
  </div>

  <% if budget.budget_categories.any? %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      <div class="bg-container rounded-xl shadow-border-xs p-4">
        <dl class="space-y-3">
          <div class="flex items-center justify-between">
            <dt class="text-secondary"><%= t("reports.budget_performance.spent") %></dt>
            <dd class="font-medium privacy-sensitive"><%= format_money(budget.actual_spending_money) %></dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-secondary"><%= t("reports.budget_performance.budgeted") %></dt>
            <dd class="font-medium privacy-sensitive"><%= format_money(budget.budgeted_spending_money) %></dd>
          </div>
        </dl>
      </div>

      <div class="bg-container rounded-xl shadow-border-xs p-4">
        <h3 class="text-sm font-medium text-primary mb-3">
          <%= t("budgets.household.member_contributions", default: "Member contributions") %>
        </h3>
        <dl class="space-y-2">
          <% budget.member_contributions.each do |member, amount| %>
            <div class="flex items-center justify-between text-sm">
              <dt class="text-secondary"><%= member.display_name %></dt>
              <dd class="font-medium privacy-sensitive"><%= format_money(amount) %></dd>
            </div>
          <% end %>
        </dl>
      </div>
    </div>

    <div class="w-full bg-container rounded-xl shadow-border-xs p-4">
      <%= render "budgets/budget_categories", budget: budget %>
    </div>
  <% else %>
    <div class="bg-container rounded-xl shadow-border-xs p-6 text-sm text-secondary">
      <%= t("budgets.household.empty", default: "Mark a category as shared to create the household budget.") %>
    </div>
  <% end %>
</section>
