<%= render DS::Dialog.new(frame: "drawer", responsive: true) do |dialog| %>
  <% dialog.with_header(
       title: @family_transfer_mirror ? t(".accept_family_transfer") : t(".header.title"),
       subtitle: @family_transfer_mirror ? @entry.transaction.family_transfer_name_for(Current.user) : t(".header.subtitle")
     ) %>
  <% dialog.with_body do %>
    <%= styled_form_with(
          url: transaction_transfer_match_path(@entry),
          scope: :transfer_match,
          class: "space-y-8",
          data: { turbo_frame: :_top }
        ) do |f| %>
      <section class="space-y-4">
        <div class="space-y-2">
          <h2 class="text-sm font-medium text-secondary">
            <%= if @family_transfer_mirror
                  t(".family_sender")
                else
                  @entry.amount.positive? ? t(".from_account_named", name: @entry.account.name) : t(".from_account")
                end %>
          </h2>

          <% if @entry.amount.positive? %>
            <%= f.select(
                  :entry_id,
                  [[@family_transfer_mirror ? [@entry.date, format_money(@entry.amount_money), @entry.transaction.family_transfer_name_for(Current.user)].join(" • ") : entry_name_detailed(@entry), @entry.id]],
                  {
                    label: @family_transfer_mirror ? t(".family_transfer") : t(".outflow_transaction"),
                    selected: @entry.id,
                  },
                  disabled: true
                ) %>
          <% else %>
            <%= render "transfer_matches/matching_fields",
                        form: f, entry: @entry, candidates: @transfer_match_candidates.map { |pm| pm.outflow_transaction.entry }, accounts: @accounts %>
          <% end %>
        </div>
      </section>

      <div class="flex justify-center py-2">
        <%= icon "arrow-down" %>
      </div>

      <section class="space-y-4">
        <div class="space-y-2">
          <h2 class="text-sm font-medium text-secondary">
            <%= @entry.amount.negative? ? t(".to_account_named", name: @entry.account.name) : t(".to_account") %>
          </h2>

          <% if @entry.amount.negative? %>
            <%= f.select(
                  :entry_id,
                  [[entry_name_detailed(@entry), @entry.id]],
                  {
                    label: t(".inflow_transaction"),
                    selected: @entry.id,
                  },
                  disabled: true
                ) %>
          <% else %>
            <%= render "transfer_matches/matching_fields",
                        form: f, entry: @entry, candidates: @transfer_match_candidates.map { |pm| pm.inflow_transaction.entry }, accounts: @accounts %>
          <% end %>
        </div>
      </section>

      <%= f.submit(@family_transfer_mirror ? t(".accept_family_transfer") : t(".create_transfer_match")) %>
    <% end %>
  <% end %>
<% end %>
